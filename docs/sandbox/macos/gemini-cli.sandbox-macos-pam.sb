;; sandbox-macos-pam.sb -- custom Seatbelt profile for Gemini CLI plus the PAM boundary
;;
;; Harness:  Gemini CLI (macOS, sandbox-exec)
;; Status:   verified format -- a custom profile file named
;;           sandbox-macos-<profile>.sb, looked up in ~/.gemini then the
;;           project's .gemini, selected with SEATBELT_PROFILE=<profile>; the
;;           launcher passes -D TARGET_DIR, TMP_DIR, HOME_DIR, CACHE_DIR and
;;           INCLUDE_DIR_0..4 (read from the source below)
;; Sources:  https://github.com/google-gemini/gemini-cli/blob/main/docs/cli/sandbox.md
;;           https://github.com/google-gemini/gemini-cli/blob/main/packages/cli/src/utils/sandbox.ts
;;           https://github.com/google-gemini/gemini-cli/blob/main/packages/cli/src/utils/sandbox-macos-permissive-open.sb
;;             (the built-in profile this follows; Apache-2.0)
;; Verified: 2026-10-02 -- the sources above read on this date; the profile
;;           loads under /usr/bin/sandbox-exec with the five -D names above
;; Base:     <base>   (PAM base directory, default ~/.pam; substituted by
;;           `pam doctor --profile gemini-cli [--base DIR]`; use the real path,
;;           `realpath ~/.pam` -- Seatbelt matches resolved paths)
;; Allow:    connect to <base>/run/pam.sock; read of <base>/run/daemon.lock;
;;           outbound TCP/UDP (Gemini's own API traffic), local binds, and
;;           the mDNSResponder socket for name resolution
;; Deny:     every other unix-socket connect; everything else under <base>
;;           (the engine's socket and API key live under <base>/engine/run);
;;           the keychain (files and the SecurityServer Mach service); signals
;;           to other processes; the LaunchServices and AppleEvents brokers;
;;           writes to PAM.app
;; Prove:    GEMINI_SANDBOX=sandbox-exec SEATBELT_PROFILE=pam gemini ...
;;           then, from a command Gemini runs, `pam doctor` must print
;;           "boundary: established"; or without Gemini:
;;             sandbox-exec -D TARGET_DIR="$PWD" -D TMP_DIR="$TMPDIR" \
;;               -D HOME_DIR="$HOME" -D CACHE_DIR="$(getconf DARWIN_USER_CACHE_DIR)" \
;;               -D INCLUDE_DIR_0=/dev/null -D INCLUDE_DIR_1=/dev/null \
;;               -D INCLUDE_DIR_2=/dev/null -D INCLUDE_DIR_3=/dev/null \
;;               -D INCLUDE_DIR_4=/dev/null -f sandbox-macos-pam.sb pam doctor
;;
;; Install:  pam doctor --profile gemini-cli > ~/.gemini/sandbox-macos-pam.sb
;;           export GEMINI_SANDBOX=sandbox-exec SEATBELT_PROFILE=pam
;;
;; Differences from the built-in permissive-open, on purpose:
;;   - outbound network is (remote ip): every unix-socket connect is refused
;;     except pam.sock (permissive-open allows them all);
;;   - com.apple.SecurityServer is not allowed, so a keychain search fails
;;     (Gemini then cannot use keychain-stored credentials inside the sandbox:
;;     sign in outside it, or use an API key in the environment);
;;   - the PAM block at the end, which must stay last (the last matching rule
;;     wins in SBPL).
;; Gemini documents nothing about Mach lookups or signals in its profiles; this
;; file grants neither beyond the DNS and trust services listed. `pam doctor`
;; run from inside is the evidence, not this comment.

(version 1)
(deny default)

(allow file-read*)
(allow process-exec)
(allow process-fork)
(allow process-info*)
(allow signal (target self))
(allow sysctl-read)

(allow file-write*
  (subpath (param "TARGET_DIR"))
  (subpath (param "TMP_DIR"))
  (subpath (param "CACHE_DIR"))
  (subpath (string-append (param "HOME_DIR") "/.npm"))
  (subpath (string-append (param "HOME_DIR") "/.cache"))
  (subpath (param "INCLUDE_DIR_0"))
  (subpath (param "INCLUDE_DIR_1"))
  (subpath (param "INCLUDE_DIR_2"))
  (subpath (param "INCLUDE_DIR_3"))
  (subpath (param "INCLUDE_DIR_4"))
  (literal "/dev/stdout")
  (literal "/dev/stderr")
  (literal "/dev/null")
  (literal "/dev/ptmx")
  (regex #"^/dev/ttys[0-9]*$"))
(allow file-ioctl (regex #"^/dev/tty.*"))

;; Process listing, DNS, directory services and certificate validation, as in
;; permissive-open, without the SecurityServer (keychain) service.
(allow mach-lookup
  (global-name "com.apple.sysmond")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.networkd")
  (global-name "com.apple.ocspd")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.mDNSResponder")
  (global-name "com.apple.mDNSResponderHelper")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.SystemConfiguration.configd"))
(allow system-socket (require-all (socket-domain AF_SYSTEM) (socket-protocol 2)))

;; Gemini's own traffic and its local OAuth callback; IP only, no unix sockets.
(allow network-inbound (local ip "*:*"))
(allow network-bind (local ip "*:*"))
(allow network-outbound (remote ip))
;; Name resolution goes through mDNSResponder's unix socket.
(allow network-outbound (remote unix-socket (literal "/private/var/run/mDNSResponder")))

;; Session relay (`pam listen <dir>`, PAM_SOCKET_DIR=<dir>): to use it instead of
;; the public socket, replace the two PAM-block lines that allow pam.sock and
;; daemon.lock with this one, and keep every deny:
;;   (allow network-outbound (remote unix-socket (literal "<dir>/pam.sock")))

;; ---- PAM block: keep last ----
;; The public socket and the lock readiness probe.
(deny file-read-data file-write* (subpath "<base>"))
(allow file-read-data (literal "<base>/run/daemon.lock"))
(allow network-outbound (remote unix-socket (literal "<base>/run/pam.sock")))

;; Private state, named one by one so that narrowing the broad rule above never
;; reopens one of them.
(deny file-read-data file-write* (subpath "<base>/admin"))
(deny file-read-data file-write* (literal "<base>/state.sqlite3"))
(deny file-read-data file-write* (literal "<base>/state.sqlite3-wal"))
(deny file-read-data file-write* (literal "<base>/state.sqlite3-shm"))
(deny file-read-data file-write* (subpath "<base>/backup"))
(deny file-read-data file-write* (subpath "<base>/model-trust"))
(deny file-read-data file-write* (subpath "<base>/engine"))
(deny file-read-data file-write* (subpath "<base>/flows"))
(deny file-read-data file-write* (subpath "<base>/log"))
(deny network-outbound (remote unix-socket (literal "<base>/admin/control.sock")))
(deny network-outbound (remote unix-socket (literal "<base>/engine/run/engine.sock")))

;; The trusted bundle, the keychain, process control and brokers.
(deny file-write* (subpath "/Applications/PAM.app"))
(deny file-read-data file-write* (subpath (string-append (param "HOME_DIR") "/Library/Keychains")))
(deny signal (target others))
(deny mach-lookup (global-name "com.apple.SecurityServer"))
(deny mach-lookup (global-name "com.apple.secd"))
(deny mach-lookup (global-name "com.apple.coreservices.launchservicesd"))
(deny mach-lookup (global-name "com.apple.coreservices.appleevents"))
(deny mach-lookup (global-name-prefix "com.apple.lsd."))

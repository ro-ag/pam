{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allow the local PAM main window to invoke bounded PAM commands and synchronize native appearance.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-bootstrap",
    "allow-catalog",
    "allow-activate-project",
    "allow-refresh-project",
    "allow-start-daemon",
    "allow-stop-daemon",
    "allow-register-gui-caller",
    "allow-decide-approval",
    "allow-load-evidence",
    "allow-load-flow-workspace",
    "allow-load-skill-inventory",
    "allow-manage-skill-library",
    "allow-load-skill-audit",
    "allow-run-skill-audit",
    "allow-open-flow",
    "allow-validate-flow",
    "allow-save-flow",
    "core:app:allow-set-app-theme"
  ]
}
